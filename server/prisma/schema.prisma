// Mailari Travels — Complete Prisma Schema
// MySQL database with full normalized design

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFFLINE
  SUSPENDED
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  DRIVER_ON_THE_WAY
  ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  CANCELLED
  REJECTED
}

enum TripType {
  LOCAL
  OUTSTATION
  AIRPORT_TRANSFER
  ONE_WAY
  ROUND_TRIP
  FULL_DAY_RENTAL
  CUSTOM
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  ONLINE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketCategory {
  BOOKING
  PAYMENT
  DRIVER
  VEHICLE
  ACCOUNT
  OTHER
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REJECTED
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  DRIVER_ON_THE_WAY
  DRIVER_ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  PAYMENT_RECEIVED
  INVOICE_GENERATED
  DOCUMENT_EXPIRY
  SUPPORT_REPLY
  SYSTEM
}

enum DocumentType {
  INSURANCE
  PUC
  PERMIT
  FITNESS
  REGISTRATION
  OTHER
}

// ══════════════════════════════════════════════════════
// USER & AUTH
// ══════════════════════════════════════════════════════

model User {
  id               String     @id @default(cuid())
  email            String?    @unique
  mobile           String?    @unique
  passwordHash     String?
  authProvider     String     @default("LOCAL")
  googleId         String?    @unique
  emailVerified    Boolean    @default(false)
  avatarUrl        String?
  role             Role
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?
  passwordResetToken String?
  passwordResetExpiry DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customerProfile  CustomerProfile?
  driverProfile    DriverProfile?
  notifications    Notification[]
  supportTickets   SupportTicket[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([mobile])
  @@index([role])
  @@map("users")
}

// ══════════════════════════════════════════════════════
// CUSTOMER PROFILE
// ══════════════════════════════════════════════════════

model CustomerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  fullName    String
  address     String?  @db.Text
  city        String?
  state       String?
  pincode     String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([userId])
  @@map("customer_profiles")
}

// ══════════════════════════════════════════════════════
// DRIVER PROFILE
// ══════════════════════════════════════════════════════

model DriverProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  fullName           String
  licenceNumber      String      @unique
  licenceExpiry      DateTime
  dateOfBirth        DateTime?
  address            String?     @db.Text
  city               String?
  state              String?
  pincode            String?
  emergencyContact   String?
  emergencyName      String?
  joiningDate        DateTime    @default(now())
  status             DriverStatus @default(AVAILABLE)
  profilePhoto       String?
  notes              String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedVehicle    Vehicle?      @relation(fields: [assignedVehicleId], references: [id])
  assignedVehicleId  String?
  bookings           Booking[]
  trips              Trip[]

  @@index([userId])
  @@index([licenceNumber])
  @@map("driver_profiles")
}

// ══════════════════════════════════════════════════════
// VEHICLE TYPE
// ══════════════════════════════════════════════════════

model VehicleType {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  seatingCapacity  Int
  luggageCapacity  Int      @default(2)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicles         Vehicle[]
  pricingRules     PricingRule[]
  bookings         Booking[]

  @@map("vehicle_types")
}

// ══════════════════════════════════════════════════════
// VEHICLE
// ══════════════════════════════════════════════════════

model Vehicle {
  id                  String        @id @default(cuid())
  registrationNumber  String        @unique
  vehicleTypeId       String
  make                String
  model               String
  variant             String?
  year                Int
  color               String
  fuelType            FuelType      @default(PETROL)
  seatingCapacity     Int
  insuranceNumber     String?
  insuranceExpiry     DateTime?
  permitNumber        String?
  permitExpiry        DateTime?
  fitnessNumber       String?
  fitnessExpiry       DateTime?
  pucNumber           String?
  pucExpiry           DateTime?
  currentOdometer     Int           @default(0)
  status              VehicleStatus @default(AVAILABLE)
  notes               String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  vehicleType         VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  assignedDrivers     DriverProfile[]
  documents           VehicleDocument[]
  bookings            Booking[]
  trips               Trip[]

  @@index([registrationNumber])
  @@index([vehicleTypeId])
  @@index([status])
  @@map("vehicles")
}

// ══════════════════════════════════════════════════════
// VEHICLE DOCUMENT
// ══════════════════════════════════════════════════════

model VehicleDocument {
  id           String       @id @default(cuid())
  vehicleId    String
  documentType DocumentType
  documentNumber String?
  issueDate    DateTime?
  expiryDate   DateTime?
  fileUrl      String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([expiryDate])
  @@map("vehicle_documents")
}

// ══════════════════════════════════════════════════════
// BOOKING
// ══════════════════════════════════════════════════════

model Booking {
  id                 String        @id @default(cuid())
  bookingNumber      String        @unique
  customerId         String
  driverId           String?
  vehicleId          String?
  vehicleTypeId      String?
  tripType           TripType
  status             BookingStatus @default(PENDING)

  // Pickup/Drop
  pickupLocation     String        @db.Text
  dropLocation       String?       @db.Text
  pickupDate         DateTime
  pickupTime         String
  returnDate         DateTime?

  // Passengers
  passengerCount     Int           @default(1)
  luggageCount       Int           @default(0)

  // Distance/Duration
  estimatedDistance  Decimal?      @db.Decimal(10, 2)
  estimatedDuration  Int?          // minutes

  // Airport fields
  flightNumber       String?
  flightType         String?       // ARRIVAL | DEPARTURE

  // Pricing
  baseFare           Decimal       @default(0) @db.Decimal(10, 2)
  distanceCharges    Decimal       @default(0) @db.Decimal(10, 2)
  driverAllowance    Decimal       @default(0) @db.Decimal(10, 2)
  tollCharges        Decimal       @default(0) @db.Decimal(10, 2)
  parkingCharges     Decimal       @default(0) @db.Decimal(10, 2)
  airportCharges     Decimal       @default(0) @db.Decimal(10, 2)
  nightCharges       Decimal       @default(0) @db.Decimal(10, 2)
  statePermitCharges Decimal       @default(0) @db.Decimal(10, 2)
  extraCharges       Decimal       @default(0) @db.Decimal(10, 2)
  discount           Decimal       @default(0) @db.Decimal(10, 2)
  subtotal           Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal       @default(0) @db.Decimal(10, 2)

  // Notes
  specialInstructions String?      @db.Text
  adminNotes         String?       @db.Text
  driverNotes        String?       @db.Text

  // Payment
  paymentStatus      PaymentStatus @default(PENDING)
  paidAmount         Decimal       @default(0) @db.Decimal(10, 2)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer           CustomerProfile @relation(fields: [customerId], references: [id])
  driver             DriverProfile?  @relation(fields: [driverId], references: [id])
  vehicle            Vehicle?        @relation(fields: [vehicleId], references: [id])
  vehicleType        VehicleType?    @relation(fields: [vehicleTypeId], references: [id])
  statusHistory      BookingStatusHistory[]
  trips              Trip[]
  payments           Payment[]
  invoice            Invoice?

  @@index([bookingNumber])
  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([pickupDate])
  @@map("bookings")
}

// ══════════════════════════════════════════════════════
// BOOKING STATUS HISTORY
// ══════════════════════════════════════════════════════

model BookingStatusHistory {
  id          String        @id @default(cuid())
  bookingId   String
  status      BookingStatus
  note        String?
  changedBy   String?       // userId
  changedByRole Role?
  createdAt   DateTime      @default(now())

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_status_history")
}

// ══════════════════════════════════════════════════════
// TRIP
// ══════════════════════════════════════════════════════

model Trip {
  id              String    @id @default(cuid())
  bookingId       String
  driverId        String?
  vehicleId       String?
  startOdometer   Int?
  endOdometer     Int?
  startTime       DateTime?
  endTime         DateTime?
  actualDistance  Decimal?  @db.Decimal(10, 2)
  actualDuration  Int?      // minutes
  driverNotes     String?   @db.Text
  issueReported   String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  booking         Booking       @relation(fields: [bookingId], references: [id])
  driver          DriverProfile? @relation(fields: [driverId], references: [id])
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@index([bookingId])
  @@index([driverId])
  @@map("trips")
}

// ══════════════════════════════════════════════════════
// PAYMENT
// ══════════════════════════════════════════════════════

model Payment {
  id                  String        @id @default(cuid())
  paymentNumber       String        @unique
  bookingId           String
  amount              Decimal       @db.Decimal(10, 2)
  paymentMethod       PaymentMethod
  status              PaymentStatus @default(PENDING)
  transactionRef      String?
  gatewayOrderId      String?
  gatewayPaymentId    String?
  paymentDate         DateTime?
  notes               String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  booking             Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([paymentNumber])
  @@index([status])
  @@map("payments")
}

// ══════════════════════════════════════════════════════
// INVOICE
// ══════════════════════════════════════════════════════

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  bookingId       String        @unique
  subtotal        Decimal       @db.Decimal(10, 2)
  cgst            Decimal       @default(0) @db.Decimal(10, 2)
  sgst            Decimal       @default(0) @db.Decimal(10, 2)
  igst            Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking         Booking       @relation(fields: [bookingId], references: [id])
  items           InvoiceItem[]

  @@index([bookingId])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ══════════════════════════════════════════════════════
// PRICING
// ══════════════════════════════════════════════════════

model PricingRule {
  id                  String   @id @default(cuid())
  vehicleTypeId       String
  tripType            TripType
  baseFare            Decimal  @default(0) @db.Decimal(10, 2)
  perKmRate           Decimal  @default(0) @db.Decimal(10, 2)
  perHourRate         Decimal  @default(0) @db.Decimal(10, 2)
  driverAllowanceDay  Decimal  @default(0) @db.Decimal(10, 2)
  nightChargeMultiplier Decimal @default(1.0) @db.Decimal(4, 2)
  extraKmRate         Decimal  @default(0) @db.Decimal(10, 2)
  airportSurcharge    Decimal  @default(0) @db.Decimal(10, 2)
  statePermitCharge   Decimal  @default(0) @db.Decimal(10, 2)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  vehicleType         VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@unique([vehicleTypeId, tripType])
  @@index([vehicleTypeId])
  @@map("pricing_rules")
}

model TaxConfig {
  id          String   @id @default(cuid())
  name        String   @unique
  cgstRate    Decimal  @default(0) @db.Decimal(5, 2)
  sgstRate    Decimal  @default(0) @db.Decimal(5, 2)
  igstRate    Decimal  @default(0) @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tax_configs")
}

// ══════════════════════════════════════════════════════
// NOTIFICATION
// ══════════════════════════════════════════════════════

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String           @db.Text
  isRead      Boolean          @default(false)
  entityType  String?
  entityId    String?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ══════════════════════════════════════════════════════
// SUPPORT
// ══════════════════════════════════════════════════════

model SupportTicket {
  id          String         @id @default(cuid())
  ticketNumber String        @unique
  userId      String
  category    TicketCategory
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    String         @default("NORMAL")
  assignedTo  String?
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id])
  messages    SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id          String    @id @default(cuid())
  ticketId    String
  senderId    String
  senderRole  Role
  message     String    @db.Text
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

// ══════════════════════════════════════════════════════
// AUDIT LOG
// ══════════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userRole    Role?
  action      String
  entity      String
  entityId    String?
  description String   @db.Text
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ══════════════════════════════════════════════════════
// SYSTEM SETTINGS
// ══════════════════════════════════════════════════════

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  label       String
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@map("system_settings")
}
