# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DATABASE
# Change this to your production database URL (e.g. Hostinger MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/mailaritravels"

# AUTHENTICATION
# Must be a long, random string in production (at least 64 characters)
JWT_SECRET=dev-secret-change-in-production-must-be-64-chars-long-at-minimum
JWT_EXPIRES_IN=7d

# GOOGLE SIGN-IN (customer accounts only — never creates ADMIN/DRIVER accounts)
GOOGLE_CLIENT_ID=

# RATE LIMITING (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# FILE UPLOADS (QR images, driver/vehicle documents)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=2097152

# EXTERNAL APIS (Optional for now)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=

# EMAIL (Optional — if unset, email notifications are recorded as unavailable rather than silently pretending to send)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
