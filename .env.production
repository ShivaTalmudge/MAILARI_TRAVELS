# ──────────────────────────────────────────────────────
# MAILARI TRAVELS CRM - PRODUCTION ENVIRONMENT VARIABLES
# ──────────────────────────────────────────────────────
# Upload this file to your Hostinger server and rename it to exactly ".env"

# 1. Environment (Required)
NODE_ENV="production"
PORT="5000"

# 2. Database Connection (Required)
# Replace YOUR_DB_USER, YOUR_DB_PASSWORD, and YOUR_DB_NAME with your Hostinger details
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/YOUR_DB_NAME"

# 3. Security (Required)
# This is a randomly generated secure key for your production environment
JWT_SECRET="8f9a2b5e7d1c4f6a9b3d7e8c1f4a6b2d5e9c7a4b1f8e3d6a9c2b5e7f1d4a8c3"
JWT_EXPIRES_IN="7d"

# 4. Frontend URL (Required)
# Update this if you use a different domain name
CLIENT_URL="https://mailaritravels.com"

# ──────────────────────────────────────────────────────
# OPTIONAL INTEGRATIONS (You can leave these blank for now)
# ──────────────────────────────────────────────────────

# Razorpay (For accepting online payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# WhatsApp API (For sending booking confirmations via WhatsApp)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_FROM_NUMBER=""
